# MongoDB connection string used by the API and seed scripts.
MONGO_URI=mongodb://127.0.0.1:27017/itsuki-no-tabi

# Use a long, unique secret in each environment.
JWT_SECRET=replace-with-a-long-random-secret

# Mailtrap API token for transactional email delivery.
MAILTRAP_TOKEN=replace-with-your-mailtrap-token

# Comma-separated browser origins allowed to send authenticated requests.
CLIENT_ORIGIN=http://localhost:5173

# API runtime settings.
PORT=5000
NODE_ENV=development

# Leave false in normal operation. This is only for an intentional non-development seed reset.
ALLOW_DESTRUCTIVE_SEED=false
